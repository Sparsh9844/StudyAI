# ──────────────────────────────────────────────────────────────
# StudyAI environment variables
# Local: copy this file to ".env.local" and fill in your real values.
#        (.env.local is gitignored and will NOT be committed.)
# Vercel: add the same variables under Project → Settings →
#        Environment Variables. Never commit real values.
# ──────────────────────────────────────────────────────────────

# Supabase project → Project Settings → API
# Used by the browser build (Vite) AND the API server, so on Vercel they
# must be available at build time and at runtime (the default).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Groq → https://console.groq.com/keys  (server-only secret, AI assistant)
GROQ_API_KEY=your-groq-api-key

# Optional overrides
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_TEMPERATURE=0.7
# PORT=5001

# Note: SUPABASE_SERVICE_ROLE_KEY is no longer used. Do not add it to
# Vercel — it bypasses Row Level Security.
